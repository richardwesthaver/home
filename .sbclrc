;;; .sbclrc --- sbcl init file -*- mode: common-lisp; -*-
(in-package :cl-user)
(require :asdf)
(require :sb-concurrency)
(require :sb-cltl2)
(require :sb-rotate-byte)
(require :sb-sprof)
(require :sb-grovel)
(require :sb-cover)

(setq *debug-beginner-help-p* nil
      ;; *print-case* :downcase
      *print-level* 32
      *print-length* 256)

(defparameter *quicklisp-setup* (or (probe-file #P"~/.stash/quicklisp/setup.lisp")
                                    (probe-file #P"/usr/share/quicklisp/setup.lisp")))

#-quicklisp
(when *quicklisp-setup*
  (load *quicklisp-setup*))
;; (ql:quickload :clouseau)

;; (require :sb-aclrepl)
#+std (std:register-project-directory #P"~/.stash/lisp/")

(cond 
  ((find-package :user) (in-package :user))
  ((find-package :std-user) (in-package :std-user)))
