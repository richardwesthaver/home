#[pager]
# requires nushell
#pager = lines | grid
[paths]
core = https://vc.compiler.company/comp/core
infra = https://vc.compiler.company/comp/infra
demo = https://vc.compiler.company/comp/demo

[ui]
username = Richard Westhaver <ellis@rwest.io>
ssh = ssh -i ~/.ssh/ellis_ed25519

[alias]
erc = !$EDITOR `$HG root`/.hg/hgrc

# [hooks]
# outgoing.notify = python:hgext.notify.hook

[email]
from = demon <demon@compiler.company>

[extensions]
gpg = 
mq = 
#fsmonitor = 
convert = 
histedit =
#rebase =
#uncommit =
churn =
clonebundles = 
highlight = 
notify = 
git = 
hgext.bookmarks=
evolve = 
hggit = ~/.hgext/hg-git/hggit
#strip =
#commitsigs = hgext/commitsigs/commitsigs.py
#logtoprocess = 

[subrepos]
allowed = true
hg:allowed = true
git:allowed = true
svn:allowed = true

[fsmonitor]
mode = on
warn_when_unused = false

[gpg]
key = ellis

[web]
baseurl = https://vc.compiler.company

[rhg]
on-unsupported = fallback
fallback-executable = /bin/hg
allowed-extensions = clonebundles,git,gpg,highlight,notify