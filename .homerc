;;; -*- mode:skel; -*-
:user ellis
:packy "~/.stash/packy"
:wm :stumpwm
:term :alacritty
:shell :bash
:browser :eww
:logger (:level :info)
:editor :emacs
:mail "~/mail"
:src "~/.stash/home/"
:tasks
((:update-skel-projects () (init-skel)))
:jobs
((update ()
  (cli/tools/mail:run-offlineimap)
  (with-emacs (e :wait nil)
   (elfeed-update)
   (package-upgrade-all))
  #$rustup update$#)
 (upgrade (update) 
  (cargo-install "alacritty" :force t)
  (cargo-install "bottom" :force t)
  (funcall #0$sudo -S pacman -Syu && paccache -r$# :input ))
 (scan-wifi () #$connmanctl scan wifi && connmanctl services$#)
 (connect-wifi () (funcall #0$connmanctl connect wifi$# :input t))
 (scan-bt () #$bluetoothctl scan on && sleep 1 && bluetoothctl devices$#)
 (bt () 
  #$rfkill unblock bluetooth$#
  #$bluetoothctl power on$#
  #$bluetoothctl agent on$#
  #$bluetoothctl connect 04:FE:A1:D4:9C:53$#)
 (mnt () 
  (funcall #0$sudo -S mount /dev/sdd /opt/store$# :input t)
  #$sudo mount /dev/sde /opt/stash$#
  #$sudo mount /dev/sdc /opt/archive$#
  #$sudo mount /dev/sdf /opt/scratch$#)
 (snapshot ()
  (funcall #0$sudo -S btrfs sub snap -r / /.snapshots/#,(time:format-date-simple)$# :input t)
  #$sudo btrfs sub snap -r /opt/stash /opt/stash/.snapshots/#,(time:format-date-simple)$#
  #$sudo btrfs sub snap -r /opt/store /opt/store/.snapshots/#,(time:format-date-simple)$#
  #$sudo btrfs sub snap -r /opt/scratch /opt/scratch/.snapshots/#,(time:format-date-simple)$#)
 (backup ()
  ;; (funcall #0$sudo -S btrfs send -f "/opt/backup/root/#,(time:format-date-simple)" /.snapshots/#,(time:format-date-simple)$# :input t)
  (funcall 
   ;;#$doas btrfs send -f "/opt/backup/stash/#,(time:format-date-simple)" /opt/stash/.snapshots/#,(time:format-date-simple)$#
   ;; #$doas btrfs send -f "/opt/backup/store/#,(time:format-date-simple)" /opt/store/.snapshots/#,(time:format-date-simple)$# :input t))
   #0$doas btrfs send -f "/opt/backup/scratch/#,(time:format-date-simple)" /opt/scratch/.snapshots/#,(time:format-date-simple)$# :input t))
 (reboot () (funcall #0$sudo -S reboot now$# :input t))
 (startx (bt mnt) #$startx$#))
:services
((emacs (:engine :systemd))
 (gnome-keyring-daemon (:engine :systemd))
 (pipewire (:engine :systemd))
 (podman (:engine :systemd))
 (ssh-agent (:engine :systemd))
 (mpd (:engine :systemd))
 ;; (bluetooth (:engine :systemd))
 )
