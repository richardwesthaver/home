:name "Richard Westhaver"
:email "richard.westhaver@gmail.com"
:version "0.1.0"
:tags ("auto")
:fmt :pretty
:vc :hg
:auto-insert t
:license :mpl2
:log-level :info
:stash ".stash"
:scratch "*scratch*"
:cache "/opt/stash/cache/skel"
:data "/opt/stash/data/skel"
:scripts ("/usr/local/share/stash/scripts" "~/.stash/scripts")
