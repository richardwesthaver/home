;;; .skelrc @ 2023-10-12.02:58:08 -*- mode: skel; -*-
:name "Richard Westhaver <ellis@rwest.io>"
:user "ellis"
:version "0.1.0"
:tags ("auto")
:fmt :pretty
:vc :hg
:auto-insert t
:license :mpl2
:log-level :info
:shed ".shed"
:stash ".stash"
:scratch ".stash/scratch"
:cache ".cache"
:registry "~/.data/skel/registry"
:scripts ("/usr/local/share/stash/scripts" "~/stash/scripts")
:alias-list
(("p" "vc push")
 ("P" "vc pull")
 ("ci" "vc commit"))
